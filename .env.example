# Postgres via Supabase transaction-mode pooler (port 6543 in cloud; 54322 direct locally)
# .env.test: use postgresql://postgres:postgres@127.0.0.1:54322/breaks_test, never the dev database (tests truncate it)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# 32 random bytes, base64: openssl rand -base64 32
DRAW_KEY_V1=replace-me
# 32 random bytes, base64, keys the HMAC of stored IP hashes: openssl rand -base64 32
IP_HASH_KEY=replace-me
CRON_SECRET=replace-me
APP_URL=http://localhost:3000
# comma-separated emails promoted to role admin on sign-in (optional)
ADMIN_EMAILS=
# Local and CI only, never on any Vercel deploy: /test/login for e2e, and the stand-in randomness beacon
# E2E_SECRET=
# BEACON=fake
